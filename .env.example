# Base URL of beem-backend. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Web client ID for "Continue with Google" (…apps.googleusercontent.com).
# Must equal GOOGLE_CLIENT_ID in beem-backend. Leave unset to keep the button as
# "coming soon". In Google Cloud Console add your site + http://localhost:3000 under
# the OAuth client's "Authorised JavaScript origins".
 NEXT_PUBLIC_GOOGLE_CLIENT_ID=728229338955-u1aq4tr42hav6bv5mmi42283s5scka5i.apps.googleusercontent.com

# Stripe publishable key (pk_...) for the embedded card form on the buy-coins drawer.
# Leave unset to keep buying in mock mode (instant, no card). Must pair with
# PAYMENT_PROVIDER=stripe + STRIPE_SECRET_KEY on the backend.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

